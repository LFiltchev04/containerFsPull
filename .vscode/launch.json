{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug onDemandBackend (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/onDemandBackend",
      "args": [],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "build-debug",
      "setupCommands": [
        { "description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },
    {
      "name": "Attach to onDemandBackend (gdb)",
      "type": "cppdbg",
      "request": "attach",
      "program": "${workspaceFolder}/onDemandBackend",
      "processId": "${command:pickProcess}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        { "description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}
